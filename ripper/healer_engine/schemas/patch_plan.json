{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PatchPlan",
  "type": "object",
  "required": ["plan_id", "target_file", "strategy", "diff_lines", "checksum_before", "safe_to_apply"],
  "properties": {
    "plan_id": { "type": "string" },
    "target_file": { "type": "string" },
    "strategy": {
      "type": "string",
      "enum": ["AST_REPLACE", "LINE_REPLACE", "CONFIG_UPDATE", "ENV_EXPORT", "PROCESS_RESTART"]
    },
    "diff_lines": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checksum_before": { "type": "string" },
    "safe_to_apply": { "type": "boolean" },
    "rollback_snapshot": { "type": "string" }
  }
}
